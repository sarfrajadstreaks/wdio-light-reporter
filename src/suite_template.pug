doctype html
html(lang="en" data-theme=theme)
  - var totalTests = stats && stats.tests ? stats.tests : 0
  - var totalPasses = stats && stats.passes ? stats.passes : 0
  - var totalFailures = stats && stats.failures ? stats.failures : 0
  - var totalSkipped = stats && stats.skipped ? stats.skipped : 0
  - var envValues = stats && stats.envs ? stats.envs : []
  - var passPct = totalTests ? ((totalPasses / totalTests) * 100) : 0
  - var failPct = totalTests ? ((totalFailures / totalTests) * 100) : 0
  - var skipPct = totalTests ? ((totalSkipped / totalTests) * 100) : 0
  - var stamp = stats && stats.timeStamp ? stats.timeStamp : (stats && stats.end ? stats.end : '-')
  - var durationMs = stats && stats.duration ? stats.duration : 0
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="author" content="sarfrajadstreaks")
    meta(name="generator" content="wdio-light-reporter — https://github.com/sarfrajadstreaks/wdio-light-reporter")
    title Light Reporter
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap")
    style(type="text/css").
      :root { --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; --c-pass:#10b981; --c-fail:#ef4444; --c-skip:#f59e0b; --c-total:#3b82f6; }
      [data-theme="light"] { --bg-body:#f8fafc; --bg-surface:#ffffff; --bg-surface-hover:#f1f5f9; --bg-nav:linear-gradient(135deg,#08e3ff 0%,#334c55 100%); --bg-badge:#f1f5f9; --text-primary:#0f172a; --text-secondary:#475569; --text-muted:#94a3b8; --border:#e2e8f0; --border-hover:#cbd5e1; --progress-bg:#e5e7eb; --code-bg:#fef2f2; --code-border:#fecaca; --code-text:#991b1b; --ring-track:#e5e7eb; }
      [data-theme="dark"] { --bg-body:#0f172a; --bg-surface:#1e293b; --bg-surface-hover:#334155; --bg-nav:linear-gradient(135deg,#0f172a 0%,#1e293b 100%); --bg-badge:#334155; --text-primary:#f1f5f9; --text-secondary:#94a3b8; --text-muted:#64748b; --border:#334155; --border-hover:#475569; --progress-bg:#334155; --code-bg:#2d1b1b; --code-border:#7f1d1d; --code-text:#fca5a5; --ring-track:#334155; }
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      body{font-family:var(--font);background:var(--bg-body);color:var(--text-primary);line-height:1.5;transition:background .3s,color .3s;min-height:100vh}
      .navbar{background:var(--bg-nav);padding:.75rem 1.5rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;border-bottom:1px solid rgba(255,255,255,.08);transition:background .4s ease}
      .nav-brand{display:flex;align-items:center;gap:.75rem;color:#fff;font-weight:700;font-size:1.1rem}.nav-brand img{height:28px}
      .suite-badge{background:rgba(255,255,255,.12);padding:.2rem .6rem;border-radius:6px;font-size:.75rem;font-weight:500;color:rgba(255,255,255,.8)}
      .nav-actions{display:flex;align-items:center;gap:.5rem}.nav-btn{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:#fff;padding:.4rem .75rem;border-radius:8px;font-size:.8rem;cursor:pointer;display:flex;align-items:center;gap:.4rem}
      .nav-btn:hover{background:rgba(255,255,255,.18)} .container{max-width:1120px;margin:0 auto;padding:1.25rem}
      .summary-strip{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:var(--text-secondary);margin-bottom:1rem}.summary-strip .meta-item{display:flex;align-items:center;gap:.35rem}.summary-strip .sep{width:1px;height:14px;background:var(--border);margin:0 .2rem}
      .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-bottom:1rem}.stat-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;padding:1rem;display:flex;align-items:center;gap:.9rem}
      .stat-icon-ring{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.1rem}.stat-card--total .stat-icon-ring{background:rgba(59,130,246,.16);color:var(--c-total)}.stat-card--passed .stat-icon-ring{background:rgba(16,185,129,.16);color:var(--c-pass)}.stat-card--failed .stat-icon-ring{background:rgba(239,68,68,.16);color:var(--c-fail)}.stat-card--skipped .stat-icon-ring{background:rgba(245,158,11,.16);color:var(--c-skip)}
      .stat-number{font-size:1.55rem;font-weight:800;line-height:1}.stat-label{font-size:.68rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-top:.2rem}.stat-card--total .stat-number{color:var(--c-total)}.stat-card--passed .stat-number{color:var(--c-pass)}.stat-card--failed .stat-number{color:var(--c-fail)}.stat-card--skipped .stat-number{color:var(--c-skip)}
      .chart-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;padding:1rem}.chart-title{font-size:.74rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.7rem}
      .pass-rate{margin-bottom:1rem}.pass-rate-bar{display:flex;height:30px;border-radius:10px;overflow:hidden;background:var(--progress-bg);gap:2px}.pass-rate-seg{display:flex;align-items:center;justify-content:center;color:#fff;font-size:.7rem;font-weight:600}
      .charts-row{display:grid;grid-template-columns:280px 1fr;gap:.75rem;margin-bottom:1rem}.donut-wrap{position:relative;width:160px;height:160px;margin:0 auto}.donut-center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column}.donut-center .pct{font-size:1.7rem;font-weight:800;color:var(--c-pass);line-height:1}.donut-center .lbl{font-size:.66rem;color:var(--text-muted)}
      .legend{display:flex;gap:.8rem;justify-content:center;margin-top:.5rem;font-size:.7rem;color:var(--text-secondary)}.legend i{margin-right:.2rem}
      .bar-chart-wrap{overflow-x:auto;padding-bottom:.25rem}
      .bar-chart{display:flex;flex-wrap:nowrap;gap:.9rem;align-items:end;min-height:245px;padding:.35rem 0 .3rem;width:100%}
      .bar-group{display:flex;flex-direction:column;align-items:center;gap:.45rem;flex:1 1 0;min-width:110px}
      .bar-total{font-size:.66rem;color:var(--text-muted);text-align:center;min-height:1rem}
      .bar-stack{width:100%;height:180px;display:flex;flex-direction:column-reverse;justify-content:flex-start;gap:2px;padding:4px;border-radius:14px 14px 10px 10px;background:linear-gradient(180deg,rgba(148,163,184,.14),rgba(148,163,184,.05));border:1px solid var(--border);box-shadow:inset 0 -1px 0 rgba(255,255,255,.04)}
      .bar-seg{width:100%;min-height:2px;border-radius:8px}
      .bar-label{font-size:.68rem;color:var(--text-secondary);line-height:1.25;text-align:center;max-width:100%;display:flex;flex-direction:column;align-items:center;gap:.2rem}
      .bar-label-top{display:flex;align-items:center;gap:.3rem;max-width:100%}
      .bar-label-text{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
      .bar-empty{font-size:.75rem;color:var(--text-muted);padding:.5rem 0}
      .section-head{display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem}.section-title{font-size:.85rem;font-weight:700}.section-count{background:var(--bg-badge);color:var(--text-secondary);font-size:.7rem;font-weight:700;padding:.15rem .55rem;border-radius:999px}.expand-btn{margin-left:auto;border:1px solid var(--border);background:var(--bg-surface);color:var(--text-secondary);padding:.35rem .7rem;border-radius:8px;font-size:.74rem;cursor:pointer}
      .env-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;margin-bottom:.75rem;overflow:hidden}.env-header{display:flex;align-items:center;gap:.7rem;padding:.8rem 1rem;cursor:pointer}.env-header:hover{background:var(--bg-surface-hover)}
      .env-chevron{font-size:.65rem;color:var(--text-muted);width:14px;text-align:center;transition:transform .2s ease}.env-card.open .env-chevron{transform:rotate(90deg)}
      .env-icons{display:flex;align-items:center;gap:.35rem;font-size:.95rem}.env-icons .env-sep{font-size:.55rem;color:var(--text-muted)}
      .env-icons .fa-linux{color:#f0bf2b}.env-icons .fa-apple{color:#a2aaad}.env-icons .fa-windows{color:#00a4ef}.env-icons .fa-android{color:#3ddc84}.env-icons .fa-chrome{color:#4285f4}.env-icons .fa-firefox-browser{color:#ff7139}.env-icons .fa-edge{color:#0078d7}.env-icons .fa-safari{color:#006cff}
      .env-version{font-size:.8rem;font-weight:600}.env-meta{margin-left:auto;display:flex;align-items:center;gap:.5rem}.env-test-count{font-size:.7rem;color:var(--text-muted)}.mini-stack{display:flex;height:6px;width:120px;border-radius:999px;overflow:hidden;background:var(--progress-bg);gap:1px}
      .env-body{display:none;border-top:1px solid var(--border)}.env-card.open .env-body{display:block}
      .scenario-node{border-bottom:1px solid var(--border)}.scenario-node:last-child{border-bottom:none}.scenario-row{display:flex;align-items:center;gap:.5rem;padding:.62rem 1rem .62rem 1.45rem;cursor:pointer}.scenario-row:hover{background:var(--bg-surface-hover)}
      .scenario-chevron{font-size:.55rem;color:var(--text-muted);width:12px;text-align:center;transition:transform .2s}.scenario-node.open>.scenario-row .scenario-chevron{transform:rotate(90deg)}.scenario-title{flex:1;font-size:.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .badge{font-size:.65rem;font-weight:700;padding:.15rem .45rem;border-radius:6px}.badge-pass{background:rgba(16,185,129,.16);color:var(--c-pass)}.badge-fail{background:rgba(239,68,68,.16);color:var(--c-fail)}.badge-skip{background:rgba(245,158,11,.16);color:var(--c-skip)}.badge-dur{background:var(--bg-badge);color:var(--text-muted)}
      .scenario-progress{display:flex;gap:1px;height:4px;width:62px;border-radius:999px;overflow:hidden}.test-list{display:none}.scenario-node.open .test-list{display:block}
      .test-item{display:flex;align-items:flex-start;gap:.5rem;padding:.45rem 1rem .45rem 2.7rem;border-top:1px solid var(--border);font-size:.78rem;cursor:pointer}.test-item:hover{background:var(--bg-surface-hover)}.test-title{flex:1;color:var(--text-secondary)}.test-dur{font-size:.66rem;color:var(--text-muted)}.test-detail{display:none}.test-item.open+.test-detail{display:block}
      .error-block{margin:0 1rem .5rem 2.7rem;padding:.75rem 1rem;background:var(--code-bg);border:1px solid var(--code-border);border-radius:8px;color:var(--code-text);font-size:.72rem;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap}
      .ctx-line{margin:0 1rem .45rem 2.7rem;font-size:.75rem;color:var(--text-secondary)}.ctx-shot{margin:0 1rem .5rem 2.7rem}.ctx-shot img{width:120px;height:80px;object-fit:cover;border-radius:8px;border:1px solid var(--border);cursor:pointer}
      .modal{display:none;position:fixed;inset:0;background:rgba(2,6,23,.75);z-index:999;align-items:center;justify-content:center;padding:1rem}.modal.show{display:flex}.modal img{max-width:min(1200px,95vw);max-height:90vh;border-radius:10px}
      .footer{border-top:1px solid var(--border);text-align:center;padding:1rem;font-size:.72rem;color:var(--text-muted)}
      @media (max-width:1024px){
        .navbar{padding:.7rem 1rem;flex-wrap:wrap;gap:.6rem}
        .nav-actions{margin-left:auto}
        .container{padding:1rem}
      }
      @media (max-width:860px){
        .stats-grid{grid-template-columns:repeat(2,1fr)}
        .charts-row{grid-template-columns:1fr}
        .summary-strip{flex-wrap:wrap;row-gap:.35rem}
        .summary-strip .sep{display:none}
        .section-head{flex-wrap:wrap}
        .expand-btn{margin-left:0}
      }
      @media (max-width:640px){
        .navbar{align-items:flex-start}
        .nav-brand{font-size:1rem;flex-wrap:wrap;row-gap:.3rem}
        .nav-actions{width:100%;justify-content:flex-start;flex-wrap:wrap}
        .nav-btn{padding:.35rem .6rem;font-size:.75rem}
        .stats-grid{grid-template-columns:1fr}
        .env-header{flex-wrap:wrap;row-gap:.45rem}
        .env-meta{margin-left:0;width:100%;justify-content:space-between}
        .mini-stack{width:100px}
      }
      @media print{
        @page{margin:10mm 8mm}
        body{-webkit-print-color-adjust:exact;print-color-adjust:exact}
        .navbar{display:none!important}
        .container{max-width:100%!important;padding:0!important;margin:0!important}
        .expand-btn{display:none!important}
        .env-body{display:block!important;border-top:1px solid var(--border)}
        .test-list{display:block!important}
        .env-chevron,.scenario-chevron{display:none}
        .stat-card,.chart-card{break-inside:avoid;page-break-inside:avoid}
        .env-card{break-inside:auto}
        .scenario-node{break-inside:auto}
        .test-item{break-inside:avoid;page-break-inside:avoid;page-break-before:page}
        .test-detail{break-inside:avoid;page-break-inside:avoid}
        .stats-grid{grid-template-columns:repeat(4,1fr)!important}
        .charts-row{grid-template-columns:280px 1fr!important}
        .modal{display:none!important}
        .bar-chart-wrap{overflow:visible!important}
      }

  body
    nav.navbar
      div.nav-brand
        img(src="data:image/png;base64," alt="cool_logo")
        span Light Reporter
        span.suite-badge= suiteName
      div.nav-actions
        button.nav-btn(type="button" onclick="toggleTheme()")
          i.fa-solid.fa-circle-half-stroke
          span#themeLabel Light
        button.nav-btn(type="button" onclick="printReport()")
          i.fa-solid.fa-share-from-square
          span Save as PDF

    div.container
      div.summary-strip
        div.meta-item
          i.fa-regular.fa-clock
          span Duration:
          strong= durationMs < 1000 ? durationMs + 'ms' : (durationMs / 1000).toFixed(1) + 's'
        div.sep
        div.meta-item
          i.fa-regular.fa-calendar
          span= stamp
        div.sep
        div.meta-item
          i.fa-solid.fa-layer-group
          span= envValues.length + ' Environments'

      div.stats-grid
        div.stat-card.stat-card--total
          div.stat-icon-ring
            i.fa-solid.fa-list-check
          div
            div.stat-number= totalTests
            div.stat-label Total Tests
        div.stat-card.stat-card--passed
          div.stat-icon-ring
            i.fa-solid.fa-circle-check
          div
            div.stat-number= totalPasses
            div.stat-label Passed
        div.stat-card.stat-card--failed
          div.stat-icon-ring
            i.fa-solid.fa-circle-xmark
          div
            div.stat-number= totalFailures
            div.stat-label Failed
        div.stat-card.stat-card--skipped
          div.stat-icon-ring
            i.fa-solid.fa-forward
          div
            div.stat-number= totalSkipped
            div.stat-label Skipped

      div.chart-card.pass-rate
        div.chart-title Overall Pass Rate
        div.pass-rate-bar
          div.pass-rate-seg(style={background:'var(--c-pass)', width: passPct + '%'})= totalPasses + ' Passed (' + passPct.toFixed(1) + '%)'
          if totalFailures > 0
            div.pass-rate-seg(style={background:'var(--c-fail)', width: failPct + '%'})= totalFailures
          if totalSkipped > 0
            div.pass-rate-seg(style={background:'var(--c-skip)', width: skipPct + '%'})= totalSkipped

      div.charts-row
        div.chart-card
          div.chart-title Distribution
          div.donut-wrap
            - var ring = 377
            - var passArc = (passPct/100)*ring
            - var failArc = (failPct/100)*ring
            - var skipArc = (skipPct/100)*ring
            svg(width='160' height='160' viewBox='0 0 160 160')
              circle(cx='80' cy='80' r='60' fill='none' stroke='var(--ring-track)' stroke-width='18')
              if passArc > 0
                circle(cx='80' cy='80' r='60' fill='none' stroke='var(--c-pass)' stroke-width='18' stroke-dasharray=passArc + ' ' + ring stroke-dashoffset='0' transform='rotate(-90 80 80)' stroke-linecap='round')
              if failArc > 0
                circle(cx='80' cy='80' r='60' fill='none' stroke='var(--c-fail)' stroke-width='18' stroke-dasharray=failArc + ' ' + ring stroke-dashoffset=-(passArc + 1) transform='rotate(-90 80 80)' stroke-linecap='round')
              if skipArc > 0
                circle(cx='80' cy='80' r='60' fill='none' stroke='var(--c-skip)' stroke-width='18' stroke-dasharray=skipArc + ' ' + ring stroke-dashoffset=-(passArc + failArc + 2) transform='rotate(-90 80 80)' stroke-linecap='round')
            div.donut-center
              div.pct= passPct.toFixed(1) + '%'
              div.lbl pass rate
          div.legend
            span
              i.fa-solid.fa-circle(style='color:var(--c-pass)')
              | Pass
            span
              i.fa-solid.fa-circle(style='color:var(--c-fail)')
              | Fail
            span
              i.fa-solid.fa-circle(style='color:var(--c-skip)')
              | Skip

        div.chart-card
          div.chart-title Results by Environment
          div.bar-chart-wrap
            div#barChart.bar-chart

      div.section-head
        span.section-title Environments
        span.section-count= envValues.length
        button#expandAllBtn.expand-btn(type='button') Expand All

      div#envCardList

    div.footer
      span Copyright © #{copyright} · Light Reporter

    script.
      const reportStats = !{JSON.stringify(stats || {})};
      const reportRuns = !{JSON.stringify(runs || {})};
      const envValues = reportStats.envs || [];

      function getBucket(envRaw) {
        const env = envRaw.split(',');
        const browser = env[0];
        const version = env[1];
        const platform = env[2];
        const profile = env[3] !== undefined ? env[3] : 'default';
        const leaf = (((reportRuns[platform] || {})[profile] || {})[browser] || {})[version];
        return {
          env,
          browser,
          version,
          platform,
          profile,
          data: leaf || { stats: { tests: 0, passes: 0, failures: 0, skipped: 0 }, scenarios: [] }
        };
      }

      function getOsIcon(os) {
        if (os === 'linux') return 'fa-brands fa-linux';
        if (os === 'window' || os === 'windows') return 'fa-brands fa-windows';
        if (os === 'macOS') return 'fa-brands fa-apple';
        if (os === 'android') return 'fa-brands fa-android';
        return 'fa-solid fa-lightbulb';
      }

      function getBrowserIcon(browser) {
        if (browser === 'chrome') return 'fa-brands fa-chrome';
        if (browser === 'firefox') return 'fa-brands fa-firefox-browser';
        if (browser === 'msedge') return 'fa-brands fa-edge';
        if (browser === 'safari') return 'fa-brands fa-safari';
        return 'fa-solid fa-lightbulb';
      }

      function fmtMs(ms) {
        if (!ms || Number.isNaN(ms)) return '0ms';
        if (ms < 1000) return `${ms}ms`;
        const s = ms / 1000;
        if (s < 60) return `${s.toFixed(1)}s`;
        const m = Math.floor(s / 60);
        const rem = Math.round(s % 60);
        return `${m}m ${rem}s`;
      }

      function renderBars(items) {
        const root = document.getElementById('barChart');
        root.innerHTML = '';

        if (!items.length) {
          root.innerHTML = '<div class="bar-empty">No environments available</div>';
          return;
        }

        const maxTests = items.reduce((max, item) => {
          const tests = (((item || {}).data || {}).stats || {}).tests || 0;
          return Math.max(max, tests);
        }, 1);

        items.forEach(item => {
          const st = item.data.stats || { tests: 0, passes: 0, failures: 0, skipped: 0 };
          const tests = st.tests || 0;
          const scaledHeight = tests ? Math.max((tests / maxTests) * 172, 16) : 8;
          const p = tests ? (st.passes / tests) * 100 : 0;
          const f = tests ? (st.failures / tests) * 100 : 0;
          const s = tests ? (st.skipped / tests) * 100 : 0;
          const passHeight = p > 0 ? Math.max((p / 100) * scaledHeight, 2) : 0;
          const failHeight = f > 0 ? Math.max((f / 100) * scaledHeight, 2) : 0;
          const skipHeight = s > 0 ? Math.max((s / 100) * scaledHeight, 2) : 0;

          const group = document.createElement('div');
          group.className = 'bar-group';
          group.innerHTML = `
            <div class="bar-total">${tests}T</div>
            <div class="bar-stack">
              ${s > 0 ? `<div class="bar-seg" style="background:var(--c-skip);height:${skipHeight}px"></div>` : ''}
              ${f > 0 ? `<div class="bar-seg" style="background:var(--c-fail);height:${failHeight}px"></div>` : ''}
              ${p > 0 ? `<div class="bar-seg" style="background:var(--c-pass);height:${passHeight}px"></div>` : ''}
            </div>
            <div class="bar-label">
              <div class="bar-label-top"><i class="${getBrowserIcon(item.browser)}"></i><span class="bar-label-text">${item.browser}</span></div>
              <div class="bar-label-text">${item.platform}</div>
            </div>
          `;
          root.appendChild(group);
        });
      }

      function renderEnvironments(items) {
        const host = document.getElementById('envCardList');
        host.innerHTML = '';
        items.forEach((item, i) => {
          const st = item.data.stats || { tests: 0, passes: 0, failures: 0, skipped: 0 };
          const tests = st.tests || 0;
          const p = tests ? (st.passes / tests) * 100 : 0;
          const f = tests ? (st.failures / tests) * 100 : 0;
          const s = tests ? (st.skipped / tests) * 100 : 0;
          const versionText = (item.version || '').replace(/_/g, '.');

          const card = document.createElement('div');
          card.className = 'env-card';
          card.id = `env-${i}`;
          card.innerHTML = `
            <div class="env-header" data-env-toggle>
              <span class="env-chevron"><i class="fa-solid fa-chevron-right"></i></span>
              <div class="env-icons">
                <i class="${getOsIcon(item.platform)}" title="${item.platform}"></i>
                <span class="env-sep"><i class="fa-solid fa-chevron-right"></i></span>
                <i class="${getBrowserIcon(item.browser)}" title="${item.browser}"></i>
              </div>
              <span class="env-version">${versionText}</span>
              <div class="env-meta">
                <span class="env-test-count">${tests} tests</span>
                <div class="mini-stack">
                  ${p > 0 ? `<div style="background:var(--c-pass);width:${p}%"></div>` : ''}
                  ${f > 0 ? `<div style="background:var(--c-fail);width:${f}%"></div>` : ''}
                  ${s > 0 ? `<div style="background:var(--c-skip);width:${s}%"></div>` : ''}
                </div>
              </div>
            </div>
            <div class="env-body"></div>
          `;

          const body = card.querySelector('.env-body');
          (item.data.scenarios || []).forEach((sc, j) => {
            const scTests = sc.tests || [];
            const cnt = scTests.length;
            const sp = cnt ? (sc.passes.length / cnt) * 100 : 0;
            const sf = cnt ? (sc.failures.length / cnt) * 100 : 0;
            const ss = cnt ? (sc.skipped.length / cnt) * 100 : 0;

            const node = document.createElement('div');
            node.className = 'scenario-node';
            node.id = `sc-${i}-${j}`;
            node.innerHTML = `
              <div class="scenario-row" data-scenario-toggle>
                <span class="scenario-chevron"><i class="fa-solid fa-chevron-right"></i></span>
                <span class="scenario-title">${sc.title || ''}</span>
                <span class="badge badge-pass">${(sc.passes || []).length}P</span>
                ${(sc.failures || []).length > 0 ? `<span class="badge badge-fail">${sc.failures.length}F</span>` : ''}
                ${(sc.skipped || []).length > 0 ? `<span class="badge badge-skip">${sc.skipped.length}S</span>` : ''}
                <span class="badge badge-dur">${fmtMs(sc.duration || 0)}</span>
                <div class="scenario-progress">
                  ${sp > 0 ? `<span style="background:var(--c-pass);width:${sp}%"></span>` : ''}
                  ${sf > 0 ? `<span style="background:var(--c-fail);width:${sf}%"></span>` : ''}
                  ${ss > 0 ? `<span style="background:var(--c-skip);width:${ss}%"></span>` : ''}
                </div>
              </div>
              <div class="test-list"></div>
            `;

            const testHost = node.querySelector('.test-list');
            scTests.forEach(ts => {
              let contexts = [];
              try { contexts = JSON.parse(ts.context || '[]'); } catch (_) { contexts = []; }
              const hasError = ts.state === 'failed' && ts.err && ts.err.stack;
              const icon = ts.state === 'passed' ? 'fa-circle-check' : ts.state === 'failed' ? 'fa-circle-xmark' : 'fa-forward';
              const iconColor = ts.state === 'passed' ? 'var(--c-pass)' : ts.state === 'failed' ? 'var(--c-fail)' : 'var(--c-skip)';

              const itemEl = document.createElement('div');
              itemEl.className = 'test-item';
              itemEl.setAttribute('data-test-item', '1');
              itemEl.innerHTML = `
                <i class="fa-solid ${icon}" style="color:${iconColor};margin-top:.2rem"></i>
                <span class="test-title">${ts.title || ''}</span>
                <span class="test-dur">${fmtMs(ts.duration || 0)}</span>
              `;

              const detail = document.createElement('div');
              detail.className = 'test-detail';
              if (hasError) {
                const err = document.createElement('div');
                err.className = 'error-block';
                err.textContent = ts.err.stack;
                detail.appendChild(err);
              }

              contexts.forEach(ctxVal => {
                if (ctxVal && typeof ctxVal === 'object' && ctxVal.title === 'Screenshot') {
                  const wrap = document.createElement('div');
                  wrap.className = 'ctx-shot';
                  const modalId = `Modal_${ts.uuid || Math.random().toString(16).slice(2)}`;
                  wrap.innerHTML = `<img src="${ctxVal.value}" data-modal-target="#${modalId}"><div class="modal" id="${modalId}"><img src="${ctxVal.value}"></div>`;
                  detail.appendChild(wrap);
                } else {
                  const line = document.createElement('div');
                  line.className = 'ctx-line';
                  line.innerHTML = `<i class="fa-solid fa-check" style="color:var(--c-pass);margin-right:.35rem"></i><span>${typeof ctxVal === 'object' ? JSON.stringify(ctxVal) : (ctxVal || '')}</span>`;
                  detail.appendChild(line);
                }
              });

              testHost.appendChild(itemEl);
              testHost.appendChild(detail);
            });

            (sc.context || []).forEach(ctx => {
              const line = document.createElement('div');
              line.className = 'ctx-line';
              line.textContent = ctx;
              testHost.appendChild(line);
            });

            body.appendChild(node);
          });

          host.appendChild(card);
        });
      }

      function toggleTheme() {
        const html = document.documentElement;
        const current = html.getAttribute('data-theme');
        const next = current === 'light' ? 'dark' : 'light';
        html.setAttribute('data-theme', next);
        document.getElementById('themeLabel').textContent = next === 'light' ? 'Dark' : 'Light';
      }

      let expanded = false;
      function toggleAll() {
        expanded = !expanded;
        document.querySelectorAll('.env-card').forEach(card => card.classList.toggle('open', expanded));
        document.querySelectorAll('.scenario-node').forEach(node => node.classList.toggle('open', expanded));
        document.getElementById('expandAllBtn').textContent = expanded ? 'Collapse All' : 'Expand All';
      }

      document.addEventListener('click', function (e) {
        const env = e.target.closest('[data-env-toggle]');
        if (env) {
          const card = env.closest('.env-card');
          if (card) card.classList.toggle('open');
          return;
        }

        const scenario = e.target.closest('[data-scenario-toggle]');
        if (scenario) {
          const node = scenario.closest('.scenario-node');
          if (node) node.classList.toggle('open');
          return;
        }

        const test = e.target.closest('[data-test-item]');
        if (test) {
          const detail = test.nextElementSibling;
          if (detail && detail.classList.contains('test-detail') && detail.innerHTML.trim() !== '') {
            test.classList.toggle('open');
          }
          return;
        }

        const trigger = e.target.closest('[data-modal-target]');
        if (trigger) {
          const target = document.querySelector(trigger.getAttribute('data-modal-target'));
          if (target) target.classList.add('show');
          return;
        }

        const modal = e.target.closest('.modal.show');
        if (modal && e.target === modal) {
          modal.classList.remove('show');
        }
      });

      document.getElementById('expandAllBtn').addEventListener('click', toggleAll);

      function printReport() {
        document.querySelectorAll('.env-card').forEach(c => c.classList.add('open'));
        document.querySelectorAll('.scenario-node').forEach(n => n.classList.add('open'));
        window.print();
      }

      const envItems = envValues.map(getBucket);
      renderBars(envItems);
      renderEnvironments(envItems);
